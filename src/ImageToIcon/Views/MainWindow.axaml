                        <TextBlock Text="hicolor" FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Vertical" HorizontalAlignment="Stretch"
                    Spacing="12" Margin="8,14">
            <ItemsControl x:Name="SizeToggles" HorizontalAlignment="Center" MaxWidth="720">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="m:SizeToggle">
                        <ToggleButton Classes="pill" Margin="2"
                                      Classes.unavailable="{Binding !IsAvailable}"
                                      Classes.autopromoted="{Binding IsAutoPromoted}"
                                      Classes.userpreferred="{Binding IsUserChecked}"
                                      Content="{Binding Label}"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button x:Name="AddSizeBtn" Classes="pill" Content="+ Add sizes"
                    HorizontalAlignment="Center"
                    ToolTip.Tip="Add sizes" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                <Button x:Name="UpdateBtn" Width="120" IsVisible="False"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Background="{DynamicResource AppUpdateBrush}"
                        Foreground="Black" />
                <Button x:Name="OpenBtn" Content="Open Image" Width="120"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                <Button x:Name="SaveBtn" Content="Save Icon" Width="120"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
            </StackPanel>
        </StackPanel>

    </Grid>
</Window>