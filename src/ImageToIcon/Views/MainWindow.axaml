<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:m="using:ImageToIcon.Models"
        mc:Ignorable="d"
        x:Class="ImageToIcon.Views.MainWindow"
        Title="Image To Icon"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        Icon="/Assets/ProgramIcon.ico"
        Background="{DynamicResource AppWindowBrush}"
        Foreground="{DynamicResource AppTextBrush}"
        Opacity="0"
        DragDrop.AllowDrop="True">

    <Window.Styles>
        <Style Selector="ToggleButton.pill">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AppSubTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.pill:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppThumbBorderBrush}" />
        </Style>
        <Style Selector="ToggleButton.pill:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppThumbBorderBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppThumbBorderBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="ToggleButton.pill:checked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppThumbBorderBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppThumbBorderBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="ToggleButton.pill.unavailable">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="ToggleButton.pill.autopromoted:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppUpdateBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppUpdateBrush}" />
            <Setter Property="Foreground" Value="Black" />
        </Style>
        <Style Selector="ToggleButton.pill.autopromoted:checked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppUpdateBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppUpdateBrush}" />
            <Setter Property="Foreground" Value="Black" />
        </Style>
        <Style Selector="ToggleButton.pill.userpreferred:not(:checked) /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AppThumbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="ToggleButton.pill.userpreferred:not(:checked):pointerover /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AppThumbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector=":is(Button).iconbtn">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.iconbtn:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
        </Style>
        <Style Selector="ToggleButton.iconbtn:checked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSeparatorBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrushPointerOver}" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundPointerOver}" />
        </Style>
        <Style Selector="ToggleButton.iconbtn:checked:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrushPressed}" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundPressed}" />
        </Style>
        <Style Selector="ToggleButton.accenttoggle:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppThumbBorderBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppThumbBorderBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="ToggleButton.accenttoggle:checked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppThumbBorderBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppThumbBorderBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="ToggleButton.accenttoggle:checked:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppThumbBorderBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppThumbBorderBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.pill">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AppSubTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.pill:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppThumbBorderBrush}" />
        </Style>
        <Style Selector="TextBlock.sizeLabel">
            <Setter Property="Foreground" Value="{DynamicResource AppThumbBorderBrush}" />
            <Setter Property="FontFamily" Value="Calibri" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style Selector="TextBlock.sizeLabel.focused">
            <Setter Property="Foreground" Value="Orange" />
        </Style>
        <Style Selector="TextBlock.focusMode">
            <Setter Property="Foreground" Value="Orange" />
        </Style>
        <Style Selector="Slider.compact">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,-6,0,-6" />
        </Style>
        <Style Selector="Slider.compact /template/ Thumb">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="Slider.focusMode">
            <Setter Property="Foreground" Value="Orange" />
        </Style>
        <Style Selector="Slider.focusMode /template/ Thumb">
            <Setter Property="Background" Value="Orange" />
            <Setter Property="BorderBrush" Value="Orange" />
        </Style>
        <Style Selector="Slider.focusMode /template/ Border#TrackBackground">
            <Setter Property="Background" Value="Orange" />
        </Style>
        <Style Selector="Button.focusMode">
            <Setter Property="Foreground" Value="Orange" />
            <Setter Property="BorderBrush" Value="Orange" />
        </Style>
        <Style Selector=":is(Shape).iconStroke">
            <Setter Property="Stroke" Value="{DynamicResource ButtonForeground}" />
        </Style>
        <Style Selector=":is(Shape).iconFill">
            <Setter Property="Fill" Value="{DynamicResource ButtonForeground}" />
        </Style>
        <Style Selector="Button.focusMode :is(Shape).iconStroke">
            <Setter Property="Stroke" Value="Orange" />
        </Style>
        <Style Selector="Button.focusMode :is(Shape).iconFill">
            <Setter Property="Fill" Value="Orange" />
        </Style>
        <Style Selector="ToggleButton.formatSeg">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="{DynamicResource AppSeparatorBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AppSubTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.formatSeg /template/ ContentPresenter">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource AppSeparatorBrush}" />
        </Style>
        <Style Selector="ToggleButton.formatSeg:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
        </Style>
        <Style Selector="ToggleButton.formatSeg:checked">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="ToggleButton.formatSeg:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppThumbBorderBrush}" />
        </Style>
        <Style Selector="ToggleButton.formatSeg:checked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppThumbBorderBrush}" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <DataTemplate x:Key="ThumbTemplate" DataType="m:IconThumb">
            <StackPanel Margin="2" Spacing="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Cursor="Hand"
                        Tag="{Binding}"
                        Background="Transparent"
                        PointerPressed="OnThumbPointerPressed"
                        PointerMoved="OnThumbPointerMoved"
                        PointerReleased="OnThumbPointerReleased"
                        PointerCaptureLost="OnThumbPointerCaptureLost"
                        PointerWheelChanged="OnThumbPointerWheel"
                        DragDrop.AllowDrop="True">
                <Grid Width="{Binding DisplaySize}" Height="{Binding DisplaySize}" HorizontalAlignment="Center"
                      ToolTip.Tip="Left-click: replace image&#x0a;Right-click: toggle focus&#x0a;Drag (crop mode): pan&#x0a;Wheel (crop mode): zoom">
                    <Image Source="{Binding Preview}" Stretch="Fill" />
                    <Rectangle Stroke="{DynamicResource AppThumbBorderBrush}"
                               StrokeThickness="1"
                               StrokeDashArray="2,2"
                               IsHitTestVisible="False"
                               IsVisible="{Binding #BorderToggle.IsChecked}" />
                    <Rectangle Stroke="Orange"
                               StrokeThickness="1"
                               StrokeDashArray="2,2"
                               IsHitTestVisible="False"
                               IsVisible="{Binding IsPaddingDragging}" />
                </Grid>
                <Grid Width="{Binding DisplaySize}" HorizontalAlignment="Center">
                    <TextBlock Text="✱"
                               Foreground="Red"
                               FontSize="8"
                               HorizontalAlignment="Left"
                               Cursor="Hand"
                               ToolTip.Tip="Reset overrides"
                               PointerPressed="OnDecoupleIconClicked"
                               IsVisible="{Binding IsDecoupled}" />
                    <TextBlock Classes="sizeLabel"
                               Classes.focused="{Binding IsFocused}"
                               Text="{Binding SizeLabel}"
                               ToolTip.Tip="{Binding TooltipText}"
                               HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid RowDefinitions="*,Auto,Auto">

        <Border Grid.Row="0" Padding="8" Background="{DynamicResource AppCategoryBrush}">
            <Grid RowDefinitions="*,Auto">
                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Center">
                        <ItemsControl x:Name="TopThumbs"
                                      ItemTemplate="{StaticResource ThumbTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ItemsControl x:Name="SmallThumbs"
                                      ItemTemplate="{StaticResource ThumbTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left" Spacing="4">
                        <ToggleButton x:Name="BorderToggle" Classes="iconbtn" IsChecked="True"
                                      ToolTip.Tip="Toggle thumb borders">
                            <Rectangle Width="12" Height="12"
                                       Stroke="{DynamicResource ButtonForeground}"
                                       StrokeThickness="1"
                                       StrokeDashArray="2,2"
                                       Opacity="0.65" />
                        </ToggleButton>
                        <Button x:Name="BgColorToggle" Classes="iconbtn"
                                ToolTip.Tip="Fill transparent background with a solid color">
                            <Grid Width="12" Height="12">
                                <Ellipse Width="12" Height="12"
                                         Stroke="{Binding #BgColorToggle.Foreground}"
                                         StrokeThickness="1"
                                         Opacity="0.65" />
                                <Path Data="M 6,0 A 6,6 0 0 0 6,12 Z"
                                      Fill="{Binding #BgColorToggle.Foreground}"
                                      Opacity="0.65" />
                            </Grid>
                        </Button>
                        <ToggleButton x:Name="DebugToggle" Classes="iconbtn accenttoggle">
                            <ToolTip.Tip>
                                <TextBlock
                                    Text="Replace frames with labeled size tiles so you can see which size the OS picks in each context"
                                    TextWrapping="Wrap" MaxWidth="240" />
                            </ToolTip.Tip>
                            <TextBlock Text="123" FontSize="9" FontWeight="Bold"
                                       Opacity="0.65"
                                       Height="12"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center" />
                        </ToggleButton>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right" Spacing="4">
                        <Button x:Name="AdjustButton" MinWidth="0" MinHeight="0" Height="22" Padding="4,3"
                                Background="{DynamicResource ButtonBackground}"
                                BorderBrush="{DynamicResource ButtonBorderBrush}"
                                Foreground="{DynamicResource ButtonForeground}"
                                VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Center"
                                ToolTip.Tip="Corner radius &amp; padding">
                            <Canvas Width="12" Height="12">
                                <Line Classes="iconStroke" StartPoint="0,3" EndPoint="12,3"
                                      StrokeThickness="1" Opacity="0.65" />
                                <Rectangle Classes="iconFill" Canvas.Left="7" Canvas.Top="1" Width="3" Height="4"
                                           Opacity="0.65" />
                                <Line Classes="iconStroke" StartPoint="0,9" EndPoint="12,9"
                                      StrokeThickness="1" Opacity="0.65" />
                                <Rectangle Classes="iconFill" Canvas.Left="2" Canvas.Top="7" Width="3" Height="4"
                                           Opacity="0.65" />
                            </Canvas>
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <Grid Width="260"
                                          ColumnDefinitions="80,*,28,22"
                                          RowDefinitions="Auto,Auto"
                                          RowSpacing="2" ColumnSpacing="6">
                                        <CheckBox x:Name="CornerEnable" Grid.Row="0" Grid.Column="0"
                                                  Content="Corner" FontSize="11"
                                                  VerticalAlignment="Center" />
                                        <Slider x:Name="MaskSlider" Grid.Row="0" Grid.Column="1"
                                                Classes="compact" Minimum="0" Maximum="100"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="0 = square, 100 = circle" />
                                        <TextBlock x:Name="MaskValue" Grid.Row="0" Grid.Column="2" Text="0"
                                                   MinWidth="28" VerticalAlignment="Center" FontSize="11"
                                                   Foreground="{DynamicResource AppSubTextBrush}" />
                                        <Button x:Name="CornerReset" Grid.Row="0" Grid.Column="3"
                                                Content="&#x21BA;" FontSize="14"
                                                Width="22" Height="18" MinHeight="0" Padding="0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                ToolTip.Tip="Reset to default" />
                                        <CheckBox x:Name="PaddingEnable" Grid.Row="1" Grid.Column="0"
                                                  Content="Padding" FontSize="11"
                                                  VerticalAlignment="Center" />
                                        <Slider x:Name="PaddingSlider" Grid.Row="1" Grid.Column="1"
                                                Classes="compact" Minimum="0" Maximum="10"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="Percent per side (floored to whole pixels)" />
                                        <TextBlock x:Name="PaddingValue" Grid.Row="1" Grid.Column="2" Text="0"
                                                   MinWidth="28" VerticalAlignment="Center" FontSize="11"
                                                   Foreground="{DynamicResource AppSubTextBrush}" />
                                        <Button x:Name="PaddingReset" Grid.Row="1" Grid.Column="3"
                                                Content="&#x21BA;" FontSize="14"
                                                Width="22" Height="18" MinHeight="0" Padding="0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                ToolTip.Tip="Reset to default" />
                                    </Grid>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="FitModeButton" MinWidth="0" MinHeight="0" Height="22" Padding="4,3"
                                Background="{DynamicResource ButtonBackground}"
                                BorderBrush="{DynamicResource ButtonBorderBrush}"
                                Foreground="{DynamicResource ButtonForeground}"
                                VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Center">
                            <Panel Width="12" Height="12">
                                <Canvas x:Name="FitIcon" Width="12" Height="12">
                                    <Rectangle Classes="iconStroke" Canvas.Left="0" Canvas.Top="0" Width="12"
                                               Height="12"
                                               StrokeThickness="1" Opacity="0.65" />
                                    <Rectangle Classes="iconStroke" Canvas.Left="3" Canvas.Top="3" Width="6" Height="6"
                                               StrokeThickness="1" Opacity="0.65" />
                                </Canvas>
                                <Canvas x:Name="StretchIcon" Width="12" Height="12" IsVisible="False">
                                    <Polygon Classes="iconFill" Points="0,0 5,0 0,5" Opacity="0.65" />
                                    <Polygon Classes="iconFill" Points="12,0 7,0 12,5" Opacity="0.65" />
                                    <Polygon Classes="iconFill" Points="0,12 5,12 0,7" Opacity="0.65" />
                                    <Polygon Classes="iconFill" Points="12,12 7,12 12,7" Opacity="0.65" />
                                </Canvas>
                                <Canvas x:Name="CropIcon" Width="12" Height="12" IsVisible="False">
                                    <Line Classes="iconStroke" StartPoint="0,0" EndPoint="6,0"
                                          StrokeThickness="1.5" Opacity="0.65" />
                                    <Line Classes="iconStroke" StartPoint="0,0" EndPoint="0,6"
                                          StrokeThickness="1.5" Opacity="0.65" />
                                    <Line Classes="iconStroke" StartPoint="12,12" EndPoint="6,12"
                                          StrokeThickness="1.5" Opacity="0.65" />
                                    <Line Classes="iconStroke" StartPoint="12,12" EndPoint="12,6"
                                          StrokeThickness="1.5" Opacity="0.65" />
                                </Canvas>
                            </Panel>
                        </Button>
                        <Button x:Name="FxButton" MinWidth="0" MinHeight="0" Height="22" Padding="4,3"
                                Background="{DynamicResource ButtonBackground}"
                                BorderBrush="{DynamicResource ButtonBorderBrush}"
                                Foreground="{DynamicResource ButtonForeground}"
                                VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Center"
                                ToolTip.Tip="Shadow &amp; stroke">
                            <Grid Width="12" Height="12">
                                <Rectangle Width="8" Height="8"
                                           Fill="{Binding #FxButton.Foreground}"
                                           Opacity="0.3"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom" />
                                <Rectangle Width="8" Height="8"
                                           Stroke="{Binding #FxButton.Foreground}"
                                           StrokeThickness="1"
                                           Fill="Transparent"
                                           Opacity="0.65"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource AppControlBorderBrush}"
                BorderThickness="0,1,0,1">
            <Grid ColumnDefinitions="*,1,*,1,*" Height="22">
                <ToggleButton x:Name="FormatIco" Grid.Column="0"
                              Classes="formatSeg" IsChecked="True"
                              ToolTip.Tip="Windows icon (.ico)">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Canvas Width="12" Height="12">
                            <Rectangle Fill="{Binding $parent[ToggleButton].Foreground}"
                                       Canvas.Left="0" Canvas.Top="0" Width="5" Height="5" />
                            <Rectangle Fill="{Binding $parent[ToggleButton].Foreground}"
                                       Canvas.Left="7" Canvas.Top="0" Width="5" Height="5" />
                            <Rectangle Fill="{Binding $parent[ToggleButton].Foreground}"
                                       Canvas.Left="0" Canvas.Top="7" Width="5" Height="5" />
                            <Rectangle Fill="{Binding $parent[ToggleButton].Foreground}"
                                       Canvas.Left="7" Canvas.Top="7" Width="5" Height="5" />
                        </Canvas>
                        <TextBlock Text=".ico" FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <Rectangle Grid.Column="1" Fill="{DynamicResource AppControlBorderBrush}" />
                <ToggleButton x:Name="FormatIcns" Grid.Column="2"
                              Classes="formatSeg"
                              ToolTip.Tip="Apple icon (.icns)">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Path Width="12" Height="14" Stretch="Uniform"
                              Fill="{Binding $parent[ToggleButton].Foreground}"
                              Data="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z" />
                        <TextBlock Text=".icns" FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <Rectangle Grid.Column="3" Fill="{DynamicResource AppControlBorderBrush}" />
                <ToggleButton x:Name="FormatHicolor" Grid.Column="4"
                              Classes="formatSeg"
                              ToolTip.Tip="Linux hicolor icon set (.png)">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Path Width="14" Height="14" Stretch="Uniform"
                              Fill="{Binding $parent[ToggleButton].Foreground}"
